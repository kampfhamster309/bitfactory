{
  "permissions": {
    "allow": [
      "Read",

      "Bash(git mv *)",
      "Bash(git -C * mv *)",
      "Bash(cd * && git mv *)",
      "Bash(git add *)",
      "Bash(git -C * add *)",
      "Bash(cd * && git add *)",
      "Bash(git commit *)",
      "Bash(git -C * commit *)",
      "Bash(cd * && git commit *)",
      "Bash(git branch *)",
      "Bash(git -C * branch *)",
      "Bash(cd * && git branch *)",
      "Bash(git worktree add *)",
      "Bash(git -C * worktree add *)",
      "Bash(cd * && git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git -C * worktree remove *)",
      "Bash(cd * && git worktree remove *)",
      "Bash(git merge *)",
      "Bash(git -C * merge *)",
      "Bash(cd * && git merge *)",
      "Bash(git push origin *)",
      "Bash(git -C * push origin *)",
      "Bash(cd * && git push origin *)",
      "Bash(git pull origin *)",
      "Bash(git -C * pull origin *)",
      "Bash(cd * && git pull origin *)",
      "Bash(git diff *)",
      "Bash(git -C * diff *)",
      "Bash(cd * && git diff *)",
      "Bash(git status*)",
      "Bash(git -C * status*)",
      "Bash(cd * && git status*)",
      "Bash(git log*)",
      "Bash(git -C * log*)",
      "Bash(cd * && git log*)",

      "Bash(python3 scripts/ticket.py *)",
      "Bash(python3 *)",
      "Bash(cd * && python3 *)",
      "Bash(python -m *)",
      "Bash(cd * && python -m *)",

      "Bash(ln -s *)",

      "Bash(tea *)",
      "Bash(curl https://YOUR-GIT-FORGE-HOST/*)",

      "Edit(backlog/**)",
      "Edit(in_progress/**)",
      "Edit(in_testing/**)",
      "Edit(done/**)",
      "Edit(needs_human/**)",
      "Edit(worktrees/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(cd * && rm -rf *)",
      "Bash(sudo *)",
      "Bash(cd * && sudo *)",
      "Bash(git push * --force*)",
      "Bash(git -C * push * --force*)",
      "Bash(cd * && git push * --force*)",
      "Bash(git branch -D *)",
      "Bash(git -C * branch -D *)",
      "Bash(cd * && git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git -C * branch -d *)",
      "Bash(cd * && git branch -d *)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(cd * && git reset --hard*)",
      "WebFetch"
    ]
  }
}
